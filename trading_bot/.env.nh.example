# 나무증권(NHPLUG) 모의 인스턴스 설정 예시 — VM: /home/ubuntu/autoTrade/nh_instance/.env.nh
# 비밀값(<...>)은 사용자가 직접 입력. 이 파일 자체에는 비밀값을 넣지 말 것.

# ── 증권사 ──
BROKER=nh
IS_SIMULATION=true
NH_APP_KEY=<나무 앱키>
NH_APP_SECRET=<나무 앱시크릿>
NH_ACCOUNT=<모의계좌번호 11자리 (acct_type 03)>
# 모의 예수금이 50억이라 키움 모의(약 4~5천만)와 맞추기 위한 상한
NH_BALANCE_CAP=50000000

# ── 인스턴스 분리 ──
BOT_DATA_DIR=/home/ubuntu/autoTrade/nh_instance/data
BOT_LOG_DIR=/home/ubuntu/autoTrade/nh_instance/logs

# ── 텔레그램: 키움 봇과 같은 봇 토큰이면 명령 수신 끄고 알림만 ──
TELEGRAM_BOT_TOKEN=<키움 .env와 같은 값>
TELEGRAM_CHAT_ID=<키움 .env와 같은 값>
TELEGRAM_POLLING=false
TELEGRAM_PREFIX=[나무]

# ── 전략 설정: 키움 봇(trading_bot/.env)과 동일하게 유지해야 비교가 공정함 ──
VM_PICKS_PATH=/home/ubuntu/invest/data/vm_picks.json
VM_TRADE_AMOUNT=3000000
LEVERAGE_AMOUNT=3000000
LEVERAGE_STRATEGY=BOLLINGER
BREAKOUT_TRADE_AMOUNT=3000000
LEVERAGE_BB_PERIOD=29
LEVERAGE_BB_MULT=0.8
LEVERAGE_ENTRY_START=10:00
LEVERAGE_INDEX_ENABLED=true
LEVERAGE_INDEX_INV_CODE=114800
